{
  "manifest_version": 3,
  "name": "ステラ 月次レポート出力（アポツール）",
  "version": "1.0.0",
  "description": "アポツールの画面から月次KPIを取り込み、Excel(.xlsx)の月次レポートを出力します（集計値のみ・患者個人情報は取り込みません）",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://*/user/*"
      ],
      "js": ["xlsx.js", "scrapers.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "月次レポート出力"
  }
}
